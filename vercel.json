{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/vercel-build.mjs",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://promptchien-api.kythuatvang.com/api/:path*" },
    { "source": "/admin", "destination": "https://promptchien-api.kythuatvang.com/admin" }
  ]
}
