        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "packageHash",
        "rulesetVersion",
        "engineVersion",
        "valid",
        "checks",
        "errors",
        "warnings"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        },
        "required": [
          "valid"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "object",
            "properties": {
              "schema": {
                "const": "passed"
              },
              "geometry": {
                "const": "passed"
              },
              "brain": {
                "const": "passed"
              },
              "sandbox": {
                "const": "passed"
              }
            },
            "required": [
              "schema",
              "geometry",
              "brain",
              "sandbox"
            ],
            "additionalProperties": false
          },
          "errors": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
