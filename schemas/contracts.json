        "body": {
          "type": "object",
          "properties": {
            "triangles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Triangle"
              },
              "minItems": 1,
              "maxItems": 60,
              "contains": {
                "type": "object",
                "properties": {
                  "core": {
                    "const": true
                  }
                },
                "required": [
                  "core"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          },
          "required": [
            "triangles"
          ],
          "additionalProperties": false
        },
        "brain": {
          "$ref": "#/$defs/BrainProgram"
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "body",
        "brain"
      ],
      "additionalProperties": false
    },
    "BotPackage": {
      "type": "object",
      "properties": {
        "packageHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "versions": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "ruleset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "botSchema": {
              "const": "1.0.0"
            },
            "brainApi": {
              "const": "1.0.0"
            },
            "replay": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "mcpApi": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            }
