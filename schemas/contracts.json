            "q": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "r": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "orientation": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "hammer",
                "scissor",
                "paper"
              ]
            },
            "core": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "q",
            "r",
            "orientation",
            "type",
            "core"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "q": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "r": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "orientation": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "type": {
              "const": "motor"
            },
            "core": {
              "const": false
            }
