            "geometry": {
              "type": "string",
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "brain": {
              "type": "string",
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "sandbox": {
              "type": "string",
