          "required": [
            "id",
            "q",
            "r",
            "orientation",
            "type",
            "core"
          ],
          "additionalProperties": false
        }
      ]
    },
    "BotDefinition": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
