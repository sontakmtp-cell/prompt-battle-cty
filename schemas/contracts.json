            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BrainRule"
                },
                "minItems": 1,
                "maxItems": 256
              }
            },
            "required": [
              "name",
              "rules"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "apiVersion",
        "initialState",
        "variables",
        "states"
      ],
      "additionalProperties": false
