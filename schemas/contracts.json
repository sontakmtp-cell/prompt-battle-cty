        "engineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "valid": {
          "type": "boolean"
        },
        "checks": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
