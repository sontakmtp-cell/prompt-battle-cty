{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptchien.local/schema/1/contracts.json",
  "$defs": {
    "IntExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "constant"
            },
            "value": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sensor"
            },
            "name": {
              "type": "string",
              "enum": [
                "tick",
                "stateTicks",
                "self.x",
                "self.y",
                "self.heading",
                "self.coreHpRatio",
                "self.combatCount",
                "self.motorCount",
                "self.loadFactor",
                "self.speed",
                "enemy.distance",
                "enemy.bearing",
                "enemy.heading",
                "enemy.coreHpRatio",
                "enemy.combatCount",
                "enemy.motorCount",
                "ring.radius",
                "self.outsideRing"
              ]
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "variable"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "math"
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "subtract",
                "min",
                "max"
              ]
            },
            "left": {
              "$ref": "#/$defs/IntExpression"
            },
            "right": {
              "$ref": "#/$defs/IntExpression"
            }
          },
          "required": [
            "kind",
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "always"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "compare"
            },
            "cmp": {
              "type": "string",
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "left": {
              "$ref": "#/$defs/IntExpression"
            },
            "right": {
              "$ref": "#/$defs/IntExpression"
            }
          },
          "required": [
            "op",
            "cmp",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "minItems": 1,
              "maxItems": 256
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/Condition"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "additionalProperties": false
        }
      ]
    },
    "BrainAction": {
      "type": "object",
      "properties": {
        "move": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "stop",
                "forward",
                "backward",
                "towardEnemy",
                "awayFromEnemy",
                "orbitLeft",
                "orbitRight"
              ]
            },
            "power": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "mode",
            "power"
          ],
          "additionalProperties": false
        },
        "turn": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "hold",
                "left",
                "right",
                "faceEnemy",
                "faceAway"
              ]
            },
            "power": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "offset": {
              "type": "integer",
              "minimum": -32,
              "maximum": 31
            }
          },
          "required": [
            "mode",
            "power",
            "offset"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "move",
        "turn"
      ],
      "additionalProperties": false
    },
    "BrainRule": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/Condition"
        },
        "action": {
          "$ref": "#/$defs/BrainAction"
        },
        "set": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "value": {
                "$ref": "#/$defs/IntExpression"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "nextState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "when",
        "action"
      ],
      "additionalProperties": false
    },
    "BrainProgram": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "1.0.0"
        },
        "initialState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "initial": {
                "type": "integer",
