      {
        "name": "engage_hunt",
        "rules": [
          {
            "when": {
              "op": "compare",
              "cmp": "eq",
              "left": {
                "kind": "sensor",
                "name": "self.outsideRing"
              },
              "right": {
                "kind": "constant",
                "value": 1
              }
            },
            "action": {
              "move": {
                "mode": "towardEnemy",
                "power": 1000
              },
              "turn": {
                "mode": "faceEnemy",
                "power": 1000,
                "offset": 0
              }
